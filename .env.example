# Optional: docker compose works without a .env file (defaults are in docker-compose.yml).
APP_VERSION=0.1.0
WEB_PORT=3000
API_PORT=8080
POSTGRES_DB=jana
POSTGRES_USER=jana
POSTGRES_PASSWORD=jana_local_only
# true: only the KATO snapshot built into the image; false: check stat.gov.kz every KATO_REFRESH_INTERVAL
OFFLINE=true
KATO_REFRESH_INTERVAL=168h
